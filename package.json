{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "dev:namecheap": "next dev --webpack --hostname 127.0.0.1",
    "build:namecheap": "next build --webpack",
    "start:namecheap": "node --env-file-if-exists=.env.namecheap server.cjs",
    "test:namecheap-startup": "node --test tests/namecheap-startup.cjs",
    "db:check:namecheap": "node --env-file-if-exists=.env.namecheap scripts/check-namecheap-db.mjs",
    "test:namecheap-db": "node --test tests/namecheap-db.mjs",
    "db:setup:namecheap": "node --env-file-if-exists=.env.namecheap scripts/setup-namecheap-db.mjs",
    "test:namecheap-schema": "node --test tests/namecheap-schema.mjs",
    "test:namecheap-accounts": "node --test tests/namecheap-accounts.mjs",
    "db:test-accounts:namecheap": "node --env-file-if-exists=.env.namecheap scripts/test-namecheap-accounts.mjs",
    "test:namecheap-account-routes": "node tests/namecheap-account-routes.mjs",
    "test:namecheap-quiz-routes": "node tests/namecheap-quiz-routes.mjs",
    "db:test-quizzes:namecheap": "node --env-file-if-exists=.env.namecheap scripts/test-namecheap-quizzes.mjs",
    "test:namecheap-quizzes": "node --test tests/namecheap-quizzes.mjs",
    "db:test-timing:namecheap": "node --env-file-if-exists=.env.namecheap scripts/test-namecheap-quiz-sessions.mjs",
    "test:namecheap-timing": "node --test tests/namecheap-quiz-sessions.mjs",
    "test:namecheap-timing-routes": "node scripts/test-namecheap-timing-routes.mjs",
    "test:namecheap-library-routes": "node tests/namecheap-library-routes.mjs",
    "test:namecheap-library": "node --test tests/namecheap-library.mjs",
    "db:test-library:namecheap": "node --env-file-if-exists=.env.namecheap scripts/test-namecheap-library.mjs",
    "mail:check:namecheap": "node --env-file-if-exists=.env.namecheap scripts/check-namecheap-smtp.mjs",
    "test:namecheap-smtp": "node --test tests/namecheap-smtp.mjs",
    "test:namecheap-reset-routes": "node scripts/test-namecheap-reset-routes.mjs",
    "db:test-recovery:namecheap": "node --env-file-if-exists=.env.namecheap scripts/test-namecheap-recovery.mjs",
    "test:namecheap-recovery": "node --test tests/namecheap-password-resets.mjs",
    "test:namecheap-ai": "node --test tests/namecheap-ai.mjs",
    "test:namecheap-allowance": "node scripts/test-namecheap-allowance.mjs",
    "db:test-ai:namecheap": "node --env-file-if-exists=.env.namecheap scripts/test-namecheap-ai.mjs",
    "test:namecheap-billing-routes": "node tests/namecheap-billing-routes.mjs",
    "test:namecheap-platform": "node --test tests/namecheap-platform.mjs",
    "test:namecheap-platform-routes": "node tests/namecheap-platform-routes.mjs",
    "db:test-platform:namecheap": "node --env-file-if-exists=.env.namecheap scripts/test-namecheap-platform.mjs",
    "test:namecheap-arena": "node --test tests/namecheap-arena.mjs",
    "test:namecheap-arena-routes": "node tests/namecheap-arena-routes.mjs",
    "db:test-arena:namecheap": "node --env-file-if-exists=.env.namecheap scripts/test-namecheap-arena.mjs",
    "test:namecheap-images": "node --test tests/namecheap-images.mjs",
    "test:namecheap-image-routes": "node tests/namecheap-image-routes.mjs",
    "images:check:namecheap": "node --env-file-if-exists=.env.namecheap scripts/check-namecheap-images.mjs",
    "test:namecheap-runtime": "node tests/namecheap-runtime.mjs && node --test tests/namecheap-env.cjs tests/namecheap-request.cjs tests/namecheap-startup.cjs",
    "admin:setup:namecheap": "node --env-file-if-exists=.env.namecheap scripts/setup-namecheap-admin.mjs",
    "test:namecheap-built": "node scripts/test-namecheap-built.mjs",
    "admin:check:namecheap": "node --env-file-if-exists=.env.namecheap scripts/check-namecheap-admin.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "unpdf": "^1.8.1",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "mysql2": "^3.15.3",
    "nodemailer": "^10.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  },
  "packageManager": "pnpm@11.25.0"
}
