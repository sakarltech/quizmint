# Copy to .env.namecheap on the private Namecheap application directory.
# Actual .env.namecheap is ignored by Git. Never paste its password into chat.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quizxpmo_quizmint
DB_USER=quizxpmo_quizmint
DB_PASSWORD=
DB_CONNECTION_LIMIT=5

# Trusted public origin for password-recovery links (HTTPS, no path).
APP_URL=https://quizmint.co.uk
SMTP_HOST=premium50.web-hosting.com
SMTP_PORT=465
SMTP_USER=hello@quizmint.co.uk
SMTP_PASSWORD=
SMTP_FROM_EMAIL=hello@quizmint.co.uk
SMTP_FROM_NAME=QuizMint
PASSWORD_RESET_DAILY_EMAIL_LIMIT=100

# Private uploaded images; outside quizmint-app and public_html. Permissions 700.
QUIZMINT_IMAGE_DIR=/home/quizxpmo/quizmint-storage/question-images
